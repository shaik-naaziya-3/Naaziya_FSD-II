<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 500px; margin: 3rem auto; padding: 1rem; }
        .card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem; }
        .btn-logout { display: inline-block; margin-top: 1rem; color: #dc2626; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>

    <div class="card">
        <h1>Welcome, <%= user %></h1>
        <p><strong>Session Status:</strong> Authenticated via <code>express-session</code>.</p>
        <p><strong>Last Activity Cookie:</strong> <%= lastVisit %></p>
        
        <hr>
        <a href="/logout" class="btn-logout">Logout</a>
    </div>

</body>
</html>