<h2>Student Portal Login</h2>

<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>

<form action="/student-login" method="POST">
  <input type="text" name="rollNumber" placeholder="Roll Number (student123)" required><br><br>
  <input type="password" name="passcode" placeholder="Passcode (portal2026)" required><br><br>
  <button type="submit">Access Portal</button>
</form>